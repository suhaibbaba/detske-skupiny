# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# compiled sanity studio
dist/

# temporary sanity runtime, generated by the CLI on every dev server start
.sanity/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc
.DS_Store
*.pem

# ide
.idea/

# env files (can opt-in for committing if needed)
.env*
!.env.example
*.local

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/


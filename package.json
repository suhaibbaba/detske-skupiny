{
  "name": "detske-skupiny",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:studio": "npm run dev -w apps/studio",
    "schema:extract": "npm run schema:extract -w apps/studio",
    "typegen": "npm run schema:extract && npm run typegen -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --project=chromium",
    "test:crawl": "playwright test --project=crawl",
    "test:all": "npm run test && npm run test:e2e && npm run test:crawl"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2"
  }
}

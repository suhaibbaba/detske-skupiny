# Sanity CMS Configuration
# Server-only: the data client (src/lib/sanity/client.ts) is `server-only`, so
# these must NOT carry a NEXT_PUBLIC_ prefix. next.config.ts inlines both names
# into the client bundle for the image URL builder alone.
SANITY_PROJECT_ID=xxxxxxx
SANITY_DATASET=sandbox

# Shared secret for POST /api/revalidate, which drops cached Sanity responses
# by tag. Unset means the endpoint refuses every request (503).
REVALIDATE_SECRET=

# Domain Configuration for i18n
# For local development, use .local domains
# For production, use your actual domain names
NEXT_PUBLIC_EN_DOMAIN=en.school.local
NEXT_PUBLIC_CS_DOMAIN=cS.school.local

NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# Brevo Configuration
# Get your API key from: https://app.brevo.com/settings/api
BREVO_API_KEY=your_brevo_api_key_here

# Cloudflare Turnstile (spam protection for the contact form)
# Create a widget at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=            # Cloudflare Turnstile secret (server-side verification)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # Turnstile site key (client widget); if unset the widget is skipped in dev
